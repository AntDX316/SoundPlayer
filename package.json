{
  "name": "soundplayer",
  "version": "1.1.0",
  "description": "A modern sound player with spectrum analyzer and library management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build",
    "build:win": "electron-builder build --win nsis",
    "build:mac": "electron-builder build --mac",
    "build:linux": "electron-builder build --linux",
    "build:all": "electron-builder build -wl",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.cjs",
    "build:unpacked": "electron-builder --dir"
  },
  "build": {
    "appId": "com.soundplayer.app",
    "productName": "Sound Player",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "SoundPlayer.exe",
      "icon": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "packElevateHelper": false,
      "createStartMenuShortcut": false,
      "differentialPackage": false,
      "unicode": true
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "preload.js",
      "package.json",
      "file-access.js"
    ],
    "asar": true,
    "compression": "maximum"
  },
  "keywords": [
    "audio",
    "player",
    "music",
    "spectrum",
    "electron"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource/material-icons": "^5.3.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
